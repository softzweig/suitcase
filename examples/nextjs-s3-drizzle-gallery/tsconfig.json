{
  "extends": "@softzweig/suitcase-typescript-config/base.json",
  "compilerOptions": {
    // What Next asks for: the bundler resolves, Next emits, and JSX is left to it.
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": [".next", ".data", "node_modules"]
}
