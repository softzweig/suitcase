{
  "name": "@softzweig/suitcase-http",
  "version": "0.0.1",
  "description": "The HTTP binding for Suitcase: the transport a client calls and the handler a server mounts.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/http"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@softzweig/suitcase-client": "workspace:*",
    "@softzweig/suitcase-core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@softzweig/suitcase-drizzle": "workspace:*",
    "@softzweig/suitcase-server": "workspace:*",
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "@softzweig/suitcase-upload-queue": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
