{
  "name": "@softzweig/suitcase-job-queue",
  "version": "0.1.1",
  "description": "A small job queue for Suitcase: named work with an in-memory driver and a port for others.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/job-queue"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "p-queue": "^10.0.0"
  },
  "devDependencies": {
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
