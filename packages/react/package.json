{
  "name": "@softzweig/suitcase-react",
  "version": "1.0.0",
  "description": "Headless React bindings for Suitcase: a provider and hooks over the client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "@softzweig/suitcase-client": "workspace:^",
    "@softzweig/suitcase-core": "workspace:^",
    "@softzweig/suitcase-upload-queue": "workspace:^",
    "react": ">=19"
  },
  "dependencies": {
    "@yornaath/batshit": "^0.14.0",
    "safe-stable-stringify": "^3.0.1"
  },
  "devDependencies": {
    "@softzweig/spindle-core": "catalog:",
    "@softzweig/suitcase-client": "workspace:*",
    "@softzweig/suitcase-core": "workspace:*",
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "@softzweig/suitcase-upload-queue": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:"
  }
}
