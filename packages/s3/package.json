{
  "name": "@softzweig/suitcase-s3",
  "version": "0.1.0",
  "description": "The S3 storage integration package for Suitcase.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/s3"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@softzweig/suitcase-core": "workspace:*",
    "@softzweig/suitcase-server": "workspace:*"
  }
}
