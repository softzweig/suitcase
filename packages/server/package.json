{
  "name": "@softzweig/suitcase-server",
  "version": "0.0.1",
  "description": "The server package containing business logic and server-side definitions.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@softzweig/suitcase-core": "workspace:*",
    "zod": "catalog:"
  }
}
