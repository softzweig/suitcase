{
  "name": "@softzweig/suitcase-server",
  "version": "1.0.0",
  "description": "The server package containing business logic and server-side definitions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/suitcase.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js",
      "default": "./dist/repository.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "default": "./dist/services/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.test.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "@softzweig/spindle-core": "catalog:",
    "@softzweig/spindle-memory": "catalog:",
    "@softzweig/suitcase-core": "workspace:^",
    "@softzweig/suitcase-job-queue": "workspace:^",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@softzweig/spindle-memory": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "fast-deep-equal": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@softzweig/spindle-core": "catalog:",
    "@softzweig/spindle-memory": "catalog:",
    "@softzweig/suitcase-core": "workspace:*",
    "@softzweig/suitcase-job-queue": "workspace:*",
    "@softzweig/suitcase-typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
